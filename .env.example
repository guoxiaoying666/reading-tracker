# ===== 伊伊的书房 — 环境变量模板 =====
# 复制此文件为 .env.local 并填入真实值

# 服务端口（默认 3000）
PORT=3000

# Supabase 项目地址（从 Supabase Dashboard > Settings > API 获取）
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名公钥（anon/public key，同上页面获取）
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DeepSeek API Key（用于 AI 读书发现卡分析，从 platform.deepseek.com 获取）
VITE_DEEPSEEK_KEY=sk-your-deepseek-key

# 聚合数据 ISBN API Key（用于 ISBN 查询获取书籍信息，从 https://www.juhe.cn/docs/api/id/155 获取）
JUHE_ISBN_KEY=your-juhe-isbn-key

# ===== 飞书阅读机器人（/api/feishu）=====
# 仓库是公开的，以下值只填在 Zeabur 环境变量里，不要写进代码或提交到仓库
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_VERIFICATION_TOKEN=your-verification-token
# 飞书后台没设置 Encrypt Key 就留空
FEISHU_ENCRYPT_KEY=
FEISHU_BITABLE_APP_TOKEN=your-bitable-app-token
FEISHU_BITABLE_TABLE_ID=tblxxx
# 家长的 open_id，孩子说了需要留意的话时提醒家长；留空则不提醒
FEISHU_PARENT_OPEN_ID=
# Supabase service role key（Settings > API），只给服务端用，用来存对话
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 孩子的称呼和出生日期（YYYY-MM-DD），用于对话称呼和卡片上的年龄
CHILD_NAME=
CHILD_BIRTHDATE=
